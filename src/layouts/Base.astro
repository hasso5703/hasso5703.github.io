---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { ogKey } from '../data/cards';
import { ui, localePath, otherLang, type Lang } from '../i18n/ui';
import { existsSync } from 'node:fs';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
  ogImage?: string;
  type?: 'website' | 'article';
  lang?: Lang;
  // The page exists in both languages: every page but the 404.
  alternate?: boolean;
}
// A page's own share card when its capture exists (public/og/<key>.png), the site's card otherwise. A French page
// shows its English page's card.
const ownCard = `/og/${ogKey(localePath(Astro.props.path, 'en'))}.png`;
const {
  title, description, path, jsonld = [], ogImage = existsSync(`public${ownCard}`) ? ownCard : '/og/default.png',
  type = 'website', lang = 'en', alternate = path !== '/404/',
} = Astro.props;
const canonical = new URL(path, SITE.url).href;
const og = new URL(ogImage, SITE.url).href;
const t = ui[lang];
// Both versions of a page name each other, and the English one is the default for any other language.
const hrefs = { en: new URL(localePath(path, 'en'), SITE.url).href, fr: new URL(localePath(path, 'fr'), SITE.url).href };
// An English page opens in French for a reader who chose French (the language switcher stores the choice) or, before
// any choice, whose browser asks for French first. It is the site's only redirect, and crawlers read both versions.
const toFrench = `
      try {
        var chosen = localStorage.getItem('lang');
        var first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
        if (chosen === 'fr' || (chosen === null && /^fr(-|$)/i.test(first))) {
          location.replace(${JSON.stringify(localePath(path, 'fr'))} + location.search + location.hash);
        }
      } catch (e) {}
    `;
// Every block of structured data says its language.
const ld = jsonld.map((j) => ('inLanguage' in j ? j : { ...j, inLanguage: lang }));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && (
      <>
        <link rel="alternate" hreflang="en" href={hrefs.en} />
        <link rel="alternate" hreflang="fr" href={hrefs.fr} />
        <link rel="alternate" hreflang="x-default" href={hrefs.en} />
      </>
    )}
    {alternate && lang === 'en' && <script is:inline set:html={toFrench} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={t.ogLocale} />
    {alternate && <meta property="og:locale:alternate" content={ui[otherLang(lang)].ogLocale} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#1a0d33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/geist-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header path={path} lang={lang} alternate={alternate} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
