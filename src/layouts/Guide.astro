---
// A guide written in Markdown: frontmatter carries the short answer, the questions and the sources, so the
// page, its FAQPage data and llms.txt say the same words. Body: plain Markdown under the answer. A French guide
// (src/pages/fr/guides/) says `lang: fr` in its frontmatter.
import Base from './Base.astro';
import Command from '../components/Command.astro';
import Faq from '../components/Faq.astro';
import { SITE } from '../data/site';
import { ui, localePath, type Lang } from '../i18n/ui';

const { frontmatter } = Astro.props;
const fm = frontmatter as {
  title: string; description: string; h1: string; answer: string; slug: string; lang?: Lang;
  published: string; faq?: { q: string; a: string }[]; sources?: { label: string; href: string }[];
  related?: { label: string; href: string }[]; install?: boolean; installNote?: string;
};
const lang: Lang = fm.lang === 'fr' ? 'fr' : 'en';
const t = ui[lang].guide;
const home = localePath('/', lang);
const index = localePath('/guides/', lang);
const path = localePath(`/guides/${fm.slug}/`, lang);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: fm.h1,
    description: fm.description,
    datePublished: fm.published,
    dateModified: SITE.updated,
    author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
    mainEntityOfPage: SITE.url + path,
    isBasedOn: (fm.sources ?? []).map((s) => s.href),
  },
  ...(fm.faq?.length
    ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: fm.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + home },
      { '@type': 'ListItem', position: 2, name: t.crumb, item: SITE.url + index },
      { '@type': 'ListItem', position: 3, name: fm.h1, item: SITE.url + path },
    ],
  },
];
---
<Base title={fm.title} description={fm.description} path={path} jsonld={jsonld} type="article" lang={lang}>
  <div class="wrap">
    <header class="page-head">
      <p class="crumbs"><a href={home}>{SITE.name}</a> / <a href={index}>{t.crumb}</a> / {fm.h1}</p>
      <h1>{fm.h1}</h1>
    </header>
    <div class="prose guide">
      <p class="answer" set:html={fm.answer} />
      <slot />
    </div>
    {fm.install !== false && (
      <section style="margin-top:48px">
        <h2 style="font-size:clamp(1.5rem,2.6vw,2rem);margin-bottom:6px">{t.install}</h2>
        <p class="muted">{fm.installNote ?? t.installNote}</p>
        <Command lang={lang} />
      </section>
    )}
    {fm.faq?.length ? (
      <section class="section" style="padding-top:72px" aria-labelledby="faq-h">
        <div class="section-head"><h2 id="faq-h">{t.questions}</h2></div>
        <Faq items={fm.faq} />
      </section>
    ) : null}
    <section style="padding-bottom:96px">
      {fm.sources?.length ? (
        <dl class="receipt">
          <dt>{t.sources}</dt>
          <dd>{fm.sources.map((s, i) => <>{i ? ', ' : ''}<a href={s.href}>{s.label}</a></>)}</dd>
          <dt>{t.checked}</dt>
          <dd>{t.checkedOn(SITE.updated, SITE.name, SITE.version)}</dd>
        </dl>
      ) : null}
      {fm.related?.length ? (
        <p class="muted" style="margin-top:20px">{t.related}{fm.related.map((r, i) => <>{i ? ', ' : ''}<a href={r.href}>{r.label}</a></>)}.</p>
      ) : null}
    </section>
  </div>
</Base>
