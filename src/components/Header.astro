---
import { SITE } from '../data/site';
import { ui, LANGS, localePath, type Lang } from '../i18n/ui';
interface Props { path: string; lang?: Lang; alternate?: boolean }
const { path, lang = 'en', alternate = true } = Astro.props;
const t = ui[lang].header;
const to = (p: string) => localePath(p, lang);
const here = (p: string) => (path === to(p) ? 'page' : undefined);
// The switcher links to the same page in each language; a page that exists in one language only (the 404) offers
// the other language's home.
const langHref = (l: Lang) => (l === lang ? path : localePath(alternate ? path : '/', l));
---
<header class="site-head">
  <div class="wrap">
    <a class="wordmark" href={to('/')} aria-label={t.home}>
      <img src="/favicon.svg" alt="" width="26" height="26" />
      <span>Alzeo</span>
    </a>
    <nav class="nav" aria-label={t.nav}>
      <a href={to('/models/')} aria-current={here('/models/')}>{t.models}</a>
      <a href={to('/guides/')} aria-current={here('/guides/')}>{t.guides}</a>
      <a class="hide-s" href={to('/dgx-spark-64gb/')} aria-current={here('/dgx-spark-64gb/')}>{t.gb64}</a>
      <a class="hide-s" href={to('/machines/')} aria-current={here('/machines/')}>{t.machines}</a>
      <a class="hide-s hide-xs" href={to('/enterprise/')} aria-current={here('/enterprise/')}>{t.enterprise}</a>
    </nav>
    <div class="head-tools">
      <a class="gh-link" href={SITE.repo} aria-label={t.github}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>GitHub</span>
      </a>
      <div class="lang-switch" role="group" aria-label={t.language}>
        {LANGS.map((l) => (
          <a href={langHref(l)} hreflang={l} lang={l} aria-label={ui[l].langName} aria-current={l === lang ? 'true' : undefined} data-set-lang={l}>{l.toUpperCase()}</a>
        ))}
      </div>
      <button class="theme-toggle" type="button" aria-label={t.theme} data-theme-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z"/></svg>
      </button>
    </div>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
  // The reader's choice of language, which the English pages read before they render (Base.astro).
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]')) {
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.setLang ?? ''); } catch (e) {}
    });
  }
</script>
