---
// Questions answered in the page and in its FAQPage data, word for word the same (answer engines check both).
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details>
      <summary>{it.q}</summary>
      <div class="a"><p set:html={it.a} /></div>
    </details>
  ))}
</div>
