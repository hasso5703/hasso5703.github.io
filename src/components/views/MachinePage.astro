---
// A machine's page, in English (/machines/<slug>/) or in French (/fr/machines/<slug>/): one template over the machines.
import Base from '../../layouts/Base.astro';
import Command from '../../components/Command.astro';
import { SITE, gh } from '../../data/site';
import { siteText } from '../../data/site.fr';
import { getMachines } from '../../data/machines.fr';
import { getLanes } from '../../data/lanes.fr';
import { ui, localePath, type Lang } from '../../i18n/ui';

interface Props { slug: string; lang: Lang }
const { slug, lang } = Astro.props;
const m = getMachines(lang).find((x) => x.slug === slug)!;
const lanes = getLanes(lang);
const t = ui[lang].machine;
const box = siteText(lang).referenceBox;
const sp = lang === 'fr' ? '\xa0' : ' ';   // between a number and its unit
const to = (p: string) => localePath(p, lang);
const path = to(`/machines/${m.slug}/`);
const has64 = m.memory.includes('64');
const title = t.title(m);
const runOn = t.runOn(m);
const description = t.description(m, has64);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: t.headline(m),
    description,
    dateModified: SITE.updated,
    author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
    about: [m.name, ...m.aka, 'NVIDIA GB10'],
    mainEntityOfPage: SITE.url + path,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + to('/') },
      { '@type': 'ListItem', position: 2, name: t.crumb, item: SITE.url + to('/machines/') },
      { '@type': 'ListItem', position: 3, name: m.name, item: SITE.url + path },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonld={jsonld} type="article" lang={lang}>
  <div class="wrap">
    <header class="page-head">
      <p class="crumbs"><a href={to('/')}>{SITE.name}</a> / <a href={to('/machines/')}>{t.crumb}</a> / {m.name}</p>
      <h1>{t.h1(m)}</h1>
      <p class="lead">{t.lead(m.aka.join(', '), m.memoryNote)}</p>
    </header>
    <div class="prose">
      <p class="answer">{t.answer(m)}</p>
      {m.tested ? <p>{m.tested}</p> : (
        <p>{t.untested(runOn)}<a href={SITE.discussions}>{t.discussions}</a>.</p>
      )}

      <h2>{t.with128}</h2>
      {t.laneNote && <p>{t.laneNote}</p>}
      <div class="table-wrap">
        <table class="data">
          <thead><tr>{t.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {lanes.map((l) => (
              <tr>
                <th scope="row"><span class="dot" style={`background:${l.hue}`}></span>{l.name}</th>
                <td><span class="num" style="font-weight:640">{l.value}{sp}{l.unit}</span>, {l.what}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {has64 && (
        <>
          <h2>{t.with64}</h2>
          <p>{t.with64Text}<a href={to('/dgx-spark-64gb/')}>{t.with64Link}</a>.</p>
        </>
      )}

      <h2>{t.install}</h2>
      <p>{t.installText}</p>
    </div>
    <Command lang={lang} />
    <dl class="receipt" style="margin-top:36px">
      <dt>{t.numbers}</dt><dd>{t.numbersText(box)}<a href={gh('BENCHMARKS.md')}>BENCHMARKS.md</a></dd>
      <dt>{t.maker}</dt><dd><a href={m.official} rel="nofollow">{m.name}</a></dd>
    </dl>
    <div style="height:96px"></div>
  </div>
</Base>
