---
// The models page, in English (/models/) or in French (/fr/models/): one template over the lanes.
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { siteText } from '../../data/site.fr';
import { getLanes, fitsOn64 } from '../../data/lanes.fr';
import { ui, localePath, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].models;
const lanes = getLanes(lang);
const box = siteText(lang).referenceBox;
const sp = lang === 'fr' ? '\xa0' : ' ';   // between a number and its unit
const home = localePath('/', lang);
const path = localePath('/models/', lang);
const model = (slug: string) => localePath(`/models/${slug}/`, lang);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.listName,
    itemListElement: lanes.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.name, url: SITE.url + model(l.slug) })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + home },
      { '@type': 'ListItem', position: 2, name: t.crumb, item: SITE.url + path },
    ],
  },
];
---
<Base title={t.title} description={t.description} path={path} jsonld={jsonld} lang={lang}>
  <div class="wrap">
    <header class="page-head">
      <p class="crumbs"><a href={home}>{SITE.name}</a> / {t.crumb}</p>
      <h1>{t.h1}</h1>
      <p class="lead">{t.lead(box)}</p>
    </header>
    <div class="table-wrap">
      <table class="data">
        <thead><tr>{t.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
        <tbody>
          {lanes.map((l) => (
            <tr>
              <th scope="row"><span class="dot" style={`background:${l.hue}`}></span><a href={model(l.slug)}>{l.name}</a><div class="muted" style="font-weight:400;font-size:14px">{l.maker}</div></th>
              <td class="n">{l.value}{sp}{l.unit}<div class="muted" style="font-weight:400;font-size:14px;white-space:normal">{l.what}</div></td>
              <td>{l.kind}</td>
              <td>{fitsOn64(l.slug) ? t.yes : t.no}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div style="height:96px"></div>
  </div>
</Base>
