---
import { SITE } from '../data/site';
import { siteText } from '../data/site.fr';
import { ui, localePath, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = ui[lang].footer;
const text = siteText(lang);
const to = (p: string) => localePath(p, lang);
---
<footer class="site-foot">
  <div class="wrap">
    <nav aria-label={t.nav}>
      <a href={SITE.repo}>{t.source}</a>
      <a href={SITE.releases}>{t.releases}</a>
      <a href={SITE.discussions}>{t.discussions}</a>
      <a href={SITE.forum}>{t.forum}</a>
      <a href={to('/models/')}>{t.models}</a>
      <a href={to('/guides/')}>{t.guides}</a>
      <a href={to('/machines/')}>{t.machines}</a>
      <a href={to('/dgx-spark-64gb/')}>{t.gb64}</a>
      <a href={to('/enterprise/')}>{t.enterprise}</a>
      <a href={to('/support/')}>{t.support}</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
    <p>{text.sentence}</p>
    <p>{t.note(text.referenceBox, SITE.updated)}</p>
  </div>
</footer>
