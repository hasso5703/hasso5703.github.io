---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { machines } from '../../data/machines';

const path = '/machines/';
const title = 'Local AI on every GB10: DGX Spark and its seven partner machines';
const description =
  'The DGX Spark and the GB10 machines of ASUS, Dell, HP, Lenovo, MSI, GIGABYTE and Acer, 64 or 128 GB: what each ' +
  'runs, measured, in one command.';
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'GB10 machines',
    itemListElement: machines.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name, url: `${SITE.url}/machines/${m.slug}/` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Machines', item: SITE.url + path },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonld={jsonld}>
  <div class="wrap">
    <header class="page-head">
      <p class="crumbs"><a href="/">{SITE.name}</a> / Machines</p>
      <h1>Every GB10 machine runs it</h1>
      <p class="lead">
        The NVIDIA DGX Spark and its partner machines share one chip, the GB10, and one system, DGX OS. The installer reads
        how much memory the box has, not which brand is on it.
      </p>
    </header>
    <ul class="machines">
      {machines.map((m) => (
        <li>
          <a href={`/machines/${m.slug}/`}>
            <span class="m-maker">{m.maker}</span>
            <span class="m-name">{m.name}</span>
            <span class="tags">{m.memory.map((g) => <span class:list={['tag', g === '64' && 't64']}>{g} GB</span>)}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="callout">
      <p><strong>64 GB or 128 GB?</strong> A 128 GB box runs all nine lanes. A 64 GB box runs Nemotron 3.5 Bolt and Qwen3.8-27B.</p>
      <a class="btn" href="/dgx-spark-64gb/">See what fits on 64 GB</a>
    </div>
    <div style="height:96px"></div>
  </div>
</Base>
