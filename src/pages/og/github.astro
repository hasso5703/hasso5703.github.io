---
// The repository's social preview (1280x640, GitHub's size), captured for its Settings page. Not used by the site.
import '../../styles/global.css';
import { lanes } from '../../data/lanes';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>social preview</title>
    <style>
      html, body { margin: 0; width: 1280px; height: 640px; overflow: hidden; }
      .card { width: 1280px; height: 640px; box-sizing: border-box; padding: 64px 80px 0; display: flex; flex-direction: column;
        background: radial-gradient(800px 440px at 85% -10%, rgba(157,92,255,.40), transparent 62%), #1a0d33; color: #fff; font-family: var(--f-ui); }
      .mark { display: flex; align-items: center; gap: 16px; font-size: 32px; font-weight: 700; letter-spacing: -0.02em; }
      .mark img { width: 56px; height: 56px; }
      h1 { margin-top: 40px; font-size: 80px; line-height: 0.98; max-width: 16ch; color: #fff; letter-spacing: -0.02em; }
      p { margin-top: 26px; font-size: 30px; line-height: 1.3; color: rgba(255,255,255,.86); max-width: 52ch; }
      .site { margin-top: 18px; font-size: 26px; color: #d6bcff; }
      .lanes { margin-top: auto; display: flex; height: 20px; margin-inline: -80px; }
      .lanes span { flex: 1; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="mark"><img src="/favicon.svg" alt="" />dgx-spark-qwen38</div>
      <h1>One command turns a DGX Spark into a private AI server</h1>
      <p>Nine measured lanes, Qwen3.8-27B at 71.4 tok/s, OpenAI and Anthropic APIs, a cockpit on your phone.</p>
      <div class="site">hasso5703.github.io</div>
      <div class="lanes">{lanes.map((l) => <span style={`background:${l.hue}`}></span>)}</div>
    </div>
  </body>
</html>
