---
// A page's share card (1200x630), captured to /og/<key>.png. Kept out of the sitemap and of search, like /og/card/.
import '../../styles/global.css';
import { lanes } from '../../data/lanes';
import { cards, type Card } from '../../data/cards';

export function getStaticPaths() {
  return cards().map((c) => ({ params: { key: c.key }, props: { c } }));
}
interface Props { c: Card }
const { c } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>share card</title>
    <style>
      html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; }
      .card { width: 1200px; height: 630px; box-sizing: border-box; padding: 60px 72px 0; display: flex; flex-direction: column;
        background: radial-gradient(760px 420px at 85% -10%, rgba(157,92,255,.40), transparent 62%), #1a0d33; color: #fff; font-family: var(--f-ui); }
      .mark { display: flex; align-items: center; gap: 16px; font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
      .mark img { width: 48px; height: 48px; }
      .kicker { margin-top: 40px; font-size: 26px; font-weight: 600; color: var(--hue, #d6bcff); }
      h1 { margin-top: 12px; font-size: 68px; line-height: 1.0; max-width: 18ch; color: #fff; letter-spacing: -0.02em; }
      .metric { margin-top: 26px; font-size: 92px; font-weight: 760; line-height: 1; color: var(--hue, #fff); letter-spacing: -0.03em; }
      p { margin-top: 18px; font-size: 28px; line-height: 1.3; color: rgba(255,255,255,.84); max-width: 46ch; }
      .lanes { margin-top: auto; display: flex; height: 18px; margin-inline: -72px; }
      .lanes span { flex: 1; }
    </style>
  </head>
  <body>
    <div class="card" style={c.hue ? `--hue:${c.hue}` : ''}>
      <div class="mark"><img src="/favicon.svg" alt="" />dgx-spark-qwen38</div>
      <div class="kicker">{c.kicker}</div>
      <h1>{c.title}</h1>
      {c.metric && <div class="metric">{c.metric}</div>}
      <p>{c.sub}</p>
      <div class="lanes">{lanes.map((l) => <span style={`background:${l.hue}`}></span>)}</div>
    </div>
  </body>
</html>
